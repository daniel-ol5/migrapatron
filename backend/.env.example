# Copiar a .env y rellenar. NUNCA subir .env al repositorio.

SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# postgresql (real) o sqlite (solo para probar sin servidor)
DB_ENGINE=postgresql
DB_NAME=migrapatron
DB_USER=postgres
DB_PASSWORD=cambiar
DB_HOST=127.0.0.1
DB_PORT=5432

# Origenes que pueden llamar a la API desde un navegador.
#   5173  web en desarrollo   (npm run dev)
#   4173  web compilado       (npm run preview)
#   5174  app movil en Chrome (flutter run -d chrome --web-port=5174)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5174,http://127.0.0.1:5174

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
